{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BgrEnvelope": {
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "type": "string"
        },
        "headSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "allOf": [
            {
              "$ref": "#/definitions/BgrIdentity"
            }
          ],
          "description": "The target assignment for queries; the reporting assignment for replies."
        },
        "inReplyTo": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/BgrMessageKind"
        },
        "messageId": {
          "type": "string"
        },
        "payload": true,
        "recipientAgentId": {
          "type": "string"
        },
        "senderAgentId": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "correlationId",
        "identity",
        "kind",
        "messageId",
        "payload",
        "recipientAgentId",
        "senderAgentId",
        "version"
      ],
      "type": "object"
    },
    "BgrIdentity": {
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/definitions/BgrRole"
        },
        "sessionId": {
          "description": "Host session identity, not the native thread UUID used by RPC threadId.",
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "teamId": {
          "type": "string"
        }
      },
      "required": [
        "agentId",
        "attemptId",
        "epoch",
        "role",
        "sessionId",
        "taskId",
        "teamId"
      ],
      "type": "object"
    },
    "BgrMessageKind": {
      "enum": [
        "task",
        "question",
        "answer",
        "progress",
        "status_query",
        "status_reply",
        "result",
        "cancel"
      ],
      "type": "string"
    },
    "BgrRole": {
      "enum": [
        "brain",
        "grunt",
        "reviewer"
      ],
      "type": "string"
    }
  },
  "properties": {
    "envelope": {
      "$ref": "#/definitions/BgrEnvelope"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "envelope",
    "threadId"
  ],
  "title": "BgrMessageNotification",
  "type": "object"
}